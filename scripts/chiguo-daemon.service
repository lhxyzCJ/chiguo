# chiguo-daemon.service — 迟菓决策引擎常驻（--loop，发送侧内聚）
# 由 scripts/install_agent.sh 阶段 6c 生成（CHIGUO_DAEMON_LOOP=1 时安装）；
# REPO/PY 占位符在安装时替换。依赖 chiguo-bridge（/agent/prompt 与 /send 转发）。
[Unit]
Description=chiguo decision daemon (loop resident, agent RPC send)
After=network-online.target chiguo-bridge.service
Wants=chiguo-bridge.service

[Service]
Type=simple
# R17: loop 模式经 bridge /agent/prompt 与 /send，须与 bridge 同源共享 token →
# 加载 wechat-bridge/.env（含 WECHAT_BRIDGE_TOKEN）；'-' 前缀容忍 .env 缺失（后续补装不阻断）
EnvironmentFile=-__REPO__/wechat-bridge/.env
ExecStart=__PY__ __REPO__/chiguo_daemon.py --loop 900 --compact
Restart=on-failure
RestartSec=10
WorkingDirectory=__REPO__

[Install]
WantedBy=multi-user.target
