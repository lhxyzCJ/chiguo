# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Windows downloads quarantine marker (can be accidentally tracked)
# Note: git fnmatch: `*.Zone.Identifier` does NOT match (leading * cannot cross the leading-dot suffix); `*Zone.Identifier` works for any basename ending in that literal
*Zone.Identifier

# Runtime state files — 隐私数据（状态/决策/对话）+ 监控/健康日志（audit/health）全部本地保留不进 git
chiguo_state.json*
chiguo_loop.pid
chiguo_state_audit.jsonl
agent_health.json
*.lock
!uv.lock

# Netease music bridge — cookie is an auth token (keep ignored); caches hold privacy (song names/times)
netease/netease_cookie.txt
netease/netease_health.json
netease/netease_qr.png
netease/recent_play_cache.json
netease/recent_play_cache.json.tmp
netease/recent_play_cache.json.tmp.*
netease/recent_play_cache.json.bak

# Git worktrees
.worktrees/

# Installer backups (scripts/install_integration.sh, .claude/settings.json)
.claude/settings.json.bak
.claude/settings.json.bak.*

# wechat-bridge — 依赖/本地配置忽略；登录态 credentials/ 目录仅本地保留（隐私，历史已重写清除）
wechat-bridge/node_modules/
wechat-bridge/.env
wechat-bridge/package-lock.json
wechat-bridge/npm-debug.log*

# tick cron 运行日志（运行时产物，不跟踪）
logs/

# agent 假死状态机（agent_health.json 本体默认跟踪；崩溃残留 tmp 忽略）
agent_health.json.tmp

# AI 工具个人配置（开发机本地，不进仓库）
.claude/

# 个人开发运维工具（dev-sync.sh 已迁至 ~/chiguo-dev/，绑定生产机 SSH host，不进公开仓库）
scripts/dev-sync.sh

# 隐私数据（本地保留，不进 git——历史已重写清除）
wechat-bridge/credentials/
chiguo_decisions.jsonl
chiguo_messages.jsonl
archive/
data/
