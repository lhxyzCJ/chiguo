# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Runtime state files — only backups/temp/lock/sensitive tokens are ignored;
# analysis-relevant runtime data (decisions/state/monitor logs) is tracked so
# the target machine can push it to GitHub for local analysis.
chiguo_state.json.bak
chiguo_state.json.tmp
chiguo_state.json.tmp.*
chiguo_loop.pid
*.lock

# Netease music bridge — cookie is an auth token (keep ignored); cache is tracked
netease_cookie.txt

*.lock

# Git worktrees
.worktrees/

# Installer backups (scripts/install_integration.sh, .claude/settings.json)
.claude/settings.json.bak
.claude/settings.json.bak.*
